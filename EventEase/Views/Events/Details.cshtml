@model Event
@{
    ViewData["Title"] = "Event Details";
}

<h1>@Model.EventName</h1>

<div class="row">
    <div class="col-md-5">
        <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="@Model.EventName" />
    </div>
    <div class="col-md-7">
        <dl class="row">
            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.EventDate.ToLongDateString()</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Venue</dt>
            <dd class="col-sm-9">
                @if (Model.Venue != null)
                {
                    <a asp-controller="Venues" asp-action="Details" asp-route-id="@Model.Venue.VenueId">@Model.Venue.VenueName</a>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Not yet assigned</span>
                }
            </dd>

            <dt class="col-sm-3">Bookings</dt>
            <dd class="col-sm-9">@(Model.Bookings != null ? Model.Bookings.Count : 0) booking(s) on record</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
