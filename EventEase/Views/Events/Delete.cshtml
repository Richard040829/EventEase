@model Event
@{
    ViewData["Title"] = "Delete Event";
}

<h1>Delete Event</h1>

@if ((bool)(ViewData["HasActiveBookings"] ?? false))
{
    <div class="alert alert-warning">
        <strong>Warning:</strong> This event has @Model.Bookings!.Count existing booking(s) linked to it.
        Deleting it will be blocked until those bookings are cancelled.
    </div>
}

<h3>Are you sure you want to delete this event?</h3>
<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-3">Event Name</dt>
            <dd class="col-sm-9">@Model.EventName</dd>
            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.EventDate.ToShortDateString()</dd>
            <dt class="col-sm-3">Venue</dt>
            <dd class="col-sm-9">@(Model.Venue?.VenueName ?? "Not yet assigned")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="EventId" />
            <button type="submit" class="btn btn-danger" @(((bool)(ViewData["HasActiveBookings"] ?? false)) ? "disabled" : "")>Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
