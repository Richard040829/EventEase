@model IEnumerable<Event>
@{
    ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Events</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Event</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by name or description..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Search</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Image</th>
            <th>@Html.DisplayNameFor(m => m.EventName)</th>
            <th>@Html.DisplayNameFor(m => m.EventDate)</th>
            <th>Venue</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td><img src="@item.ImageUrl" style="width:80px;height:55px;object-fit:cover;" class="rounded" alt="@item.EventName" onerror="this.src='https://picsum.photos/seed/fallback/600/400'" /></td>
            <td>@item.EventName</td>
            <td>@item.EventDate.ToShortDateString()</td>
            <td>
                @if (item.Venue != null)
                {
                    @item.Venue.VenueName
                }
                else
                {
                    <span class="badge bg-warning text-dark">Venue not yet assigned</span>
                }
            </td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-secondary">Details</a>
                <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No events found.</p>
}
