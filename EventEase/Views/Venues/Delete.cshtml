@model Venue
@{
    ViewData["Title"] = "Delete Venue";
}

<h1>Delete Venue</h1>

@if ((bool)(ViewData["HasActiveBookings"] ?? false))
{
    <div class="alert alert-warning">
        <strong>Warning:</strong> This venue has @Model.Bookings!.Count existing booking(s) linked to it.
        Deleting it will be blocked until those bookings are cancelled or reassigned.
    </div>
}

<h3>Are you sure you want to delete this venue?</h3>
<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-3">Venue Name</dt>
            <dd class="col-sm-9">@Model.VenueName</dd>
            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>
            <dt class="col-sm-3">Capacity</dt>
            <dd class="col-sm-9">@Model.Capacity</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="VenueId" />
            <button type="submit" class="btn btn-danger" @(((bool)(ViewData["HasActiveBookings"] ?? false)) ? "disabled" : "")>Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
