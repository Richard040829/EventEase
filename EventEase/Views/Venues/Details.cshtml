@model Venue
@{
    ViewData["Title"] = "Venue Details";
}

<h1>@Model.VenueName</h1>

<div class="row">
    <div class="col-md-5">
        <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="@Model.VenueName" />
    </div>
    <div class="col-md-7">
        <dl class="row">
            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>

            <dt class="col-sm-3">Capacity</dt>
            <dd class="col-sm-9">@Model.Capacity guests</dd>

            <dt class="col-sm-3">Upcoming Events</dt>
            <dd class="col-sm-9">
                @if (Model.Events != null && Model.Events.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var e in Model.Events)
                        {
                            <li>@e.EventName (@e.EventDate.ToShortDateString())</li>
                        }
                    </ul>
                }
                else
                {
                    <span class="text-muted">None</span>
                }
            </dd>

            <dt class="col-sm-3">Bookings</dt>
            <dd class="col-sm-9">
                @(Model.Bookings != null ? Model.Bookings.Count : 0) booking(s) on record
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.VenueId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
