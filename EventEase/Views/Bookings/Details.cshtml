@model Booking
@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking #@Model.BookingId</h1>

<dl class="row">
    <dt class="col-sm-3">Event</dt>
    <dd class="col-sm-9">@Model.Event?.EventName</dd>

    <dt class="col-sm-3">Venue</dt>
    <dd class="col-sm-9">@Model.Venue?.VenueName</dd>

    <dt class="col-sm-3">Booking Date</dt>
    <dd class="col-sm-9">@Model.BookingDate.ToLongDateString()</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.BookingId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
