@model IEnumerable<Booking>
@{
    ViewData["Title"] = "Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Bookings</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Booking</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by event or venue..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Search</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Booking ID</th>
            <th>Event</th>
            <th>Venue</th>
            <th>@Html.DisplayNameFor(m => m.BookingDate)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>#@item.BookingId</td>
            <td>@item.Event?.EventName</td>
            <td>@item.Venue?.VenueName</td>
            <td>@item.BookingDate.ToShortDateString()</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-secondary">Details</a>
                <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-danger">Cancel</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No bookings found.</p>
}
